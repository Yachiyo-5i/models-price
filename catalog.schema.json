{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_version",
    "updated_at",
    "brands"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "brands": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/brand"
      }
    }
  },
  "$defs": {
    "brand": {
      "type": "object",
      "required": [
        "models"
      ],
      "properties": {
        "display_name": {
          "type": "string"
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "model_key",
        "display_name",
        "provider",
        "category",
        "supported_endpoint_types",
        "status"
      ],
      "properties": {
        "model_key": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "object"
        },
        "supported_endpoint_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "modalities": {
          "type": "object"
        },
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input_price": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "output_price": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_1h_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "pricing_variants": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "pricing_source": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "archived"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  }
}